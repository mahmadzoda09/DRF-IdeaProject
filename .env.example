# Скопируйте в .env и заполните: cp .env.example .env
# .env не попадает в git

# длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=savdo.softclub.tj,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://savdo.softclub.tj,http://savdo.softclub.tj

# ИИ-ассистент (Groq): ключ с https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# куда docker отдаёт сайт: 127.0.0.1:8080 — только для nginx сервера (он принимает домен и https)
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
